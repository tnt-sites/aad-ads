---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import Text from "@core-elements/text/Text.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  anchorName = "",
  heading = "",
  subtext = "",
  buttonSections = [],
  imageSource = "",
  imageAlt = "",
  reverse = false,
  compact = false,
  colorScheme = "inherit",
  backgroundColor,
  backgroundGradient = "",
  backgroundImage,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["service-split", className]}
  paddingHorizontal="none"
  paddingVertical="none"
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  backgroundGradient={backgroundGradient}
  backgroundImage={backgroundImage}
  {...htmlAttributes}
>
  {anchorName && <a name={anchorName} class="anchor-name-offset" aria-hidden="true" />}
  <div class:list={["service-split-grid", { reverse, compact }]}>
    <div class="service-split-text">
      <Heading
        level={compact ? "h3" : "h2"}
        class="service-split-heading"
        data-prop="heading"
        text={heading}
      />
      <Text data-prop="subtext" text={subtext} />
      <ButtonGroup class="buttons" buttonSections={buttonSections} direction="row" alignX="start" />
    </div>
    <div class="service-split-image">
      <Image
        source={imageSource}
        alt={imageAlt}
        editable={true}
        data-prop-src="imageSource"
        data-prop-alt="imageAlt"
        data-editable="image"
      />
    </div>
  </div>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .service-split-grid {
      display: flex; align-items: center; justify-content: space-around;
      min-height: 34rem;
      padding-block: 80px;

      &.reverse {
        .service-split-text {
          order: 2;
        }

        .service-split-image {
          order: 1;
        }
      }
    }

    .service-split-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 10px;
      max-width: 510px;
      margin: 0 auto;

    }

    .service-split-heading {
      margin: 0 0 var(--spacing-md);
      font-size: 54px;
      line-height: 1;
    }

    .service-split-image {
      display: flex;
      align-items: center;
      justify-content: center;
      padding-inline: var(--spacing-2xl);
    }

    @media (max-width: 1024px) {
      .service-split-grid,
      .service-split-grid.reverse {
        display: block;
        min-height: 0; 
        text-align: center;

        .service-split-text,
        .service-split-image {
          order: initial;
        }

        .service-split-text {
          align-items: center;
          margin-inline: auto;
          text-align: center;

          .heading,
          .text {
            text-align: center;
          }

          .buttons {
            justify-content: center;
          }
        }

        .service-split-image {
          order: -1;
        }
      }
    }

    .service-split-grid.compact {
      min-height: 0;
      padding-block: 20px;
      max-width: 1140px; margin: 0 auto;

      .service-split-text {
        max-width: 900px;
        padding-block: var(--spacing-md);
      }

      .service-split-heading {
        font-size: var(--font-size-heading-lg);
        margin: 0;
      }

      .service-split-image {
        padding: 0;
        flex: 0 1 270px;

        .image {
          max-width: 270px;
        }
      }
    }
  }
</style>
