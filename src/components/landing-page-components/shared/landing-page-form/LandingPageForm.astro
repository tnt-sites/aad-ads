---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import siteInfo from "@data/siteInfo.json";
import Form from "@forms/form/Form.astro";

const {
  heading = "Request an Appointment",
  formAction = "",
  formBlocks = [],
  backgroundColor = "base",
  id = "",
  backgroundImage,
  backgroundGradient = "",
  class: className,
  editable = true,
  ...rest
} = Astro.props;

const sectionStyle = [backgroundGradient ? `--section-bg-gradient: ${backgroundGradient}` : ""]
  .filter(Boolean)
  .join("; ");

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["landing-page-form", className]}
  maxContentWidth="2xl"
  paddingHorizontal="lg"
  paddingVertical="4xl"
  colorScheme="default"
  backgroundColor={backgroundColor}
  backgroundImage={backgroundImage}
  style={sectionStyle || undefined}
  {...htmlAttributes}
>
  <Heading level="h2" size="xl" alignX="center" data-prop="heading" text={heading} />
  <p class="lp-intro">
    Thank you for your interest in {siteInfo.siteName}. Please fill out your information in the form
    below and a member of our team will reach out to you soon.
  </p>
  <Form class="lp-form" action={formAction} formBlocks={formBlocks?.length > 0 ? formBlocks : []}>
    <slot />
  </Form>
</CustomSection>

<style lang="pcss" is:global>
  @layer page-sections {
    .landing-page-form {
      .heading {
        color: var(--color-brand);
        font-size: 40px;
        font-weight: 500;

        @media (min-width: 1024px) {
          font-size: 55px;
        }
      }

      .lp-intro {
        font-size: 20px;
        line-height: 1.75;
        margin: var(--spacing-lg) auto 0;
        max-width: 700px;
        text-align: center;
      }

      .lp-form {
        margin: var(--spacing-2xl) auto var(--spacing-lg);
        max-width: 550px;

        .label {
          display: none;
        }

        .field {
          background-color: var(--color-bg-surface);
          border: 1px solid #ddd;
          border-radius: 10px;
          color: var(--color-text);
          font-size: 17px;
          padding: 15px 20px;
          width: 100%;

          &:focus {
            background-color: #fff;
            outline: 2px solid var(--color-brand-secondary);
            outline-offset: 0;
          }
        }

        .textarea .field {
          height: 200px;
        }

        .submit {
          display: block;
          margin: auto;
          width: 200px;
        }

        editable-array-item:has(.submit) {
          display: flex;
          justify-content: center;
        }
      }
    }
  }
</style>
