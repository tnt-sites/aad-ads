---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import { getCollection } from "astro:content";

const {
  heading = "Sitemap",
  practice = "",
  hiddenPages = [] as string[],
  headingColor = "",
  backgroundColor = "base",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [headingColor ? `--sitemap-heading-color: ${headingColor}` : ""]
  .filter(Boolean)
  .join("; ");

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);

// Every landing page on this site, minus the ones editors chose to hide
// (thank-you pages and the sitemap itself, typically).
const hidden = hiddenPages.map((id: string) => id.toLowerCase());
const pages = (await getCollection("landing-pages"))
  .filter((page) => !hidden.includes(page.id.toLowerCase()))
  .sort((a, b) => a.id.localeCompare(b.id));
---

<CustomSection
  class:list={["landing-sitemap", className]}
  paddingVertical="none"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={backgroundColor}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="block">
    <article>
      <p class="eyebrow">Explore</p>
      <h1 data-prop="heading">{heading || "Sitemap"}</h1>
      <p class="intro">Browse the pages available on {practice || "this practice"}.</p>
      <nav aria-label="Sitemap pages">
        <ul>
          {
            pages.map((page) => (
              <li>
                <a href={`/landing/${page.id}/`}>{page.data.title || page.id}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </article>
  </div>
</CustomSection>

<style>
  .landing-sitemap article {
    margin: 0 auto;
    max-width: 900px;
    padding: 90px 0 100px;
  }

  .landing-sitemap .eyebrow {
    margin: 0;
    color: var(--sitemap-heading-color, var(--color-brand));
    font: 700 21px/1.25 var(--font-headings);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .landing-sitemap h1 {
    margin: 12px 0 28px;
    color: var(--sitemap-heading-color, var(--color-brand));
    font: 400 clamp(48px, 6vw, 72px) / 1.1 var(--font-headings);
  }

  .landing-sitemap .intro {
    margin: 0;
    font-size: 22px;
    line-height: 1.55;
  }

  .landing-sitemap nav {
    margin-top: 44px;
  }

  .landing-sitemap ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    text-align: left;
  }

  .landing-sitemap li {
    margin: 0;
    padding: 0;
  }

  .landing-sitemap li::before {
    content: none;
  }

  .landing-sitemap a {
    display: block;
    border: 1px solid #d9e2e8;
    color: var(--sitemap-heading-color, var(--color-brand));
    font-size: 22px;
    font-weight: 700;
    padding: 18px 22px;
    text-decoration: none;
  }

  .landing-sitemap a:hover {
    background: var(--sitemap-heading-color, var(--color-brand));
    color: #fff;
  }

  @media (width < 1025px) {
    .landing-sitemap article {
      padding: 64px 0 80px;
    }

    .landing-sitemap .intro,
    .landing-sitemap a {
      font-size: 19px;
    }
  }
</style>
