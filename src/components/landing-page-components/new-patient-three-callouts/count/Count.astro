---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";

interface Card {
  image: { source: string; alt: string };
  text: string;
  listItems: string[];
}

const {
  cards = [] as Card[],
  badgeImage = { source: "", alt: "" },
  primaryCardColor = "",
  accentCardColor = "",
  accentCardTextColor = "",
  bulletColor = "",
  overlapBanner = true,
  backgroundColor = "base",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  primaryCardColor && `--nptc-card-color: ${primaryCardColor}`,

  accentCardColor && `--nptc-accent-card-color: ${accentCardColor}`,
  accentCardTextColor && `--nptc-accent-card-text-color: ${accentCardTextColor}`,
  bulletColor && `--nptc-bullet-color: ${bulletColor}`,
]
  .filter(Boolean)
  .join("; ");

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);

const hasBadge = !!badgeImage?.source;
---

<CustomSection
  class:list={["nptc-count", overlapBanner && "overlap-banner", hasBadge && "has-badge", className]}
  paddingHorizontal="md"
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={backgroundColor}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="cards block lg:flex justify-center items-stretch">
    {
      cards.map((card: Card, index: number) => (
        <div class="card">
          {index === 1 && hasBadge && (
            <span class="badge hidden lg:block">
              <Image
                source={badgeImage.source}
                alt={badgeImage.alt || ""}
                rounded={false}
                editable={false}
                aspectRatio="none"
                sizes="auto"
                widths={[]}
              />
            </span>
          )}
          {card.image?.source && (
            <span class="img">
              <Image
                source={card.image.source}
                alt={card.image.alt || ""}
                rounded={false}
                editable={false}
                aspectRatio="none"
                sizes="auto"
                widths={[]}
              />
            </span>
          )}
          <span class="text" set:html={card.text} />
          {card.listItems?.length > 0 && (
            <ul>
              {card.listItems.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>
</CustomSection>

<style>
  /* Spacing is padding: CustomSection zeroes its first/last child's margins */
  .nptc-count .cards {
    margin: 0 auto;
    max-width: 600px;
    padding: 100px 0;
  }

  .nptc-count .card {
    align-items: center;
    background-color: var(--nptc-card-color, var(--color-bg-surface));
    box-shadow: 3px 3px 16px 0 rgba(0, 0, 0, 0.16);
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin: 0 auto 10px;
    overflow: visible; /* the global .card rule clips; the badge sits above the card */
    padding: 35px 25px;
    position: relative;
  }

  .nptc-count .card:first-child {
    border-radius: 40px 40px 0 0;
  }

  .nptc-count .card:last-child {
    border-radius: 0 0 40px 40px;
  }

  /* Middle card */
  .nptc-count .card:nth-child(2) {
    background-color: var(--nptc-accent-card-color, var(--color-bg-brand));
    color: var(--nptc-accent-card-text-color, var(--color-text-inverse));
    padding: 65px 25px;
    z-index: 2;
  }

  .nptc-count .card:nth-child(2) .text {
    color: var(--nptc-accent-card-text-color, var(--color-text-inverse));
  }

  /* Badge over the middle card (desktop only) */
  .nptc-count .badge {
    left: 50%;
    pointer-events: none;
    position: absolute;
    top: -105px;
    transform: translateX(-50%);
    width: 248px;
    z-index: 6;
  }

  /*  Icon image  */
  .nptc-count .img {
    align-items: center;
    display: flex;
    height: 75px;
    justify-content: center;
    margin: 0 auto 10px;
    width: 90px;
  }

  .nptc-count .img :global(img) {
    max-height: 75px;
    width: auto;
  }

  /*  Card text  */
  .nptc-count .text {
    display: block;
    font-family: var(--font-body);
    font-size: 34px;
    letter-spacing: 3.4px;
    line-height: 1.05;
    margin-bottom: 10px;
    text-align: center;
  }

  /*  List  */
  .nptc-count ul {
    font-family: var(--font-body);
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    text-align: left;
  }

  .nptc-count ul li {
    font-size: 19px;
    line-height: 1.2;
    margin: 10px auto;
    padding-left: 22px;
    position: relative;
  }

  .nptc-count ul li::before {
    color: var(--nptc-bullet-color, var(--color-text));
    content: "+";
    font-size: 20px;
    left: 0;
    line-height: 1;
    position: absolute;
    top: 1px;
  }

  @media (min-width: 1024px) {
    .nptc-count .cards {
      gap: 10px;
      max-width: 1150px;
    }

    .nptc-count.overlap-banner {
      margin-top: -100px;
      z-index: 20;
    }

    .nptc-count.overlap-banner .cards {
      padding-top: 0;
    }

    .nptc-count .card {
      flex: 1 1 367px;
      margin: 0;
      min-height: 380px;
    }

    .nptc-count .card:first-child {
      border-radius: 40px 0 0 40px;
    }

    .nptc-count .card:last-child {
      border-radius: 0 40px 40px 0;
    }

    .nptc-count .card:nth-child(2) {
      flex-basis: 396px;
    }

    .nptc-count.has-badge .card:nth-child(2) {
      padding-top: 150px;
    }

    /* The badge replaces the middle card's icon on desktop */
    .nptc-count.has-badge .card:nth-child(2) .img {
      display: none;
    }

    .nptc-count .text {
      font-size: 32px;
      letter-spacing: 3px;
    }

    .nptc-count ul li {
      font-size: 20px;
    }
  }
</style>
