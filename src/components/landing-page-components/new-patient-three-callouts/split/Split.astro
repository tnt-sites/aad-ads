---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

interface Group {
  subheading: string;
  listItems: string[];
}

const {
  heading = "",
  listItems = [],
  groups = [] as Group[],
  image = { source: "", alt: "" },
  figcaption = "",
  reverse = false,
  buttonSections = [],
  accentColor = "",
  headingColor = "",
  backgroundColor = "base",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  accentColor ? `--nptc-accent-color: ${accentColor}` : "",
  headingColor ? `--nptc-heading-color: ${headingColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["nptc-split", className]}
  paddingVertical="none"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={backgroundColor}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div
    class:list={[
      "flex-ed block lg:flex justify-between items-center",
      reverse && "lg:flex-row-reverse",
    ]}
  >
    <article>
      <Heading text={heading} level="h2" data-prop="heading" editable={true} />
      {
        listItems.length > 0 && (
          <ul>
            {listItems.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
      {
        groups.map((group: Group) => (
          <>
            {group.subheading && <h3>{group.subheading}</h3>}
            {group.listItems?.length > 0 && (
              <ul>
                {group.listItems.map((item: string) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </>
        ))
      }
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>
    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {figcaption && <figcaption>{figcaption}</figcaption>}
    </figure>
  </div>
</CustomSection>

<style>
  .nptc-split .flex-ed {
    margin: 0 auto;
    max-width: 1150px;
    padding: 50px 10px;
  }

  .nptc-split article {
    text-align: center;
  }

  .nptc-split article :global(.heading) {
    color: var(--nptc-heading-color, var(--color-brand));
    font-family: var(--font-headings);
    font-size: 46px;
    font-weight: 500;
    line-height: 1.25;
    margin: 0 0 20px;
    text-align: inherit;
  }

  .nptc-split h3 {
    color: var(--nptc-heading-color, var(--color-brand));
    font-family: var(--font-headings);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.25;
    margin: 30px 0 0;
  }

  .nptc-split article :global(.heading) + h3 {
    margin-top: 0;
  }

  /* List: centered as a block on mobile, items stay left-aligned */
  .nptc-split ul {
    display: table;
    font-family: var(--font-body);
    list-style: none;
    margin: 0 auto;
    padding: 0;
    text-align: left;
  }

  .nptc-split ul li {
    font-size: 24px;
    line-height: 1.15;
    margin: 15px 0;
    padding-left: 30px;
    position: relative;
  }

  .nptc-split ul li::before {
    color: var(--nptc-accent-color, var(--color-brand));
    content: "+";
    font-size: 28px;
    font-weight: 700;
    left: 0;
    line-height: 1;
    position: absolute;
    top: 0;
  }

  .nptc-split article :global(.button-group) {
    justify-content: center;
    margin-top: 20px;
  }

  .nptc-split figure {
    margin: 40px auto 0;
    max-width: 525px;
  }

  .nptc-split figure :global(img) {
    border-radius: 40px;
    display: block;
    width: 100%;
  }

  .nptc-split figcaption {
    color: #1a1a1a;
    display: block;
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 2.1px;
    line-height: 1.25;
    margin-top: 20px;
    text-align: center;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .nptc-split .flex-ed {
      gap: 50px;
    }

    .nptc-split article {
      flex: 0 1 575px;
      text-align: left;
    }

    .nptc-split article :global(.heading) {
      font-size: 55px;
    }

    .nptc-split h3 {
      font-size: 40px;
    }

    .nptc-split ul {
      display: block;
    }

    .nptc-split ul li {
      font-size: 28px;
      margin: 20px 0;
    }

    .nptc-split ul li::before {
      font-size: 34px;
      top: 2px;
    }

    .nptc-split article :global(.button-group) {
      justify-content: flex-start;
    }

    .nptc-split figure {
      flex: 0 1 525px;
      margin: 0;
    }

    .nptc-split figcaption {
      font-size: 21px;
    }
  }
</style>
