---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Image from "@core-elements/image/Image.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";

const {
  subheading = "",
  heading = "",
  badgeImage = { source: "", alt: "" },
  badgeMobileOnly = false,
  image = { source: "", alt: "" },
  mobileImage = { source: "", alt: "" },
  figcaption = "",
  buttonSections = [],
  accentColor = "",
  headingColor = "",
  backgroundColor = "base",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  accentColor ? `--nptc-accent-color: ${accentColor}` : "",
  headingColor ? `--nptc-heading-color: ${headingColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["nptc-banner", className]}
  paddingVertical="none"
  colorScheme="default"
  backgroundColor={backgroundColor}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="flex-ed block lg:flex items-end">
    <article>
      <h1>
        {subheading && <small>{subheading}</small>}
        <span set:html={heading} />
      </h1>
      {
        badgeImage?.source && (
          <span class:list={["badge", badgeMobileOnly && "mobile-only"]}>
            <Image
              source={badgeImage.source}
              alt={badgeImage.alt || ""}
              rounded={false}
              editable={true}
              aspectRatio="none"
              sizes="auto"
              widths={[]}
              data-prop-src="badgeImage.source"
              data-prop-alt="badgeImage.alt"
            />
          </span>
        )
      }
      {buttonSections.length > 0 && <ButtonGroup buttonSections={buttonSections} />}
    </article>
    <figure>
      <Image
        source={image.source}
        alt={image.alt}
        class={mobileImage?.source ? "hidden lg:block" : undefined}
        rounded={false}
        editable={true}
        aspectRatio="none"
        sizes="auto"
        data-prop-src="image.source"
        data-prop-alt="image.alt"
      />
      {
        mobileImage?.source && (
          <Image
            source={mobileImage.source}
            alt={mobileImage.alt || image.alt}
            class="lg:hidden"
            rounded={false}
            editable={true}
            aspectRatio="none"
            sizes="auto"
            data-prop-src="mobileImage.source"
            data-prop-alt="mobileImage.alt"
          />
        )
      }
      {figcaption && <figcaption set:html={figcaption} />}
    </figure>
  </div>
</CustomSection>

<style>
  .nptc-banner {
    overflow: hidden;
  }

  .nptc-banner .flex-ed {
    margin: 0 auto;
    max-width: 1400px;
    position: relative;
  }

  .nptc-banner article {
    padding: 80px 20px 0;
    position: relative;
    text-align: center;
    z-index: 3;
  }

  /* Three-sided bracket decoration: left, top, bottom borders (desktop only) */
  .nptc-banner article::before {
    border: 3px solid var(--nptc-accent-color, var(--color-brand));
    border-right: 0;
    bottom: 170px;
    content: "";
    display: none;
    left: 80px;
    pointer-events: none;
    position: absolute;
    top: 85px;
    width: 100px;
  }

  .nptc-banner h1 {
    color: var(--nptc-heading-color, var(--color-text));
    font-family: var(--font-headings);
    font-size: 56px;
    font-weight: 500;
    line-height: 1.14;
    margin: 0;
  }

  .nptc-banner h1 small {
    color: var(--nptc-accent-color, var(--color-brand));
    display: block;
    font-family: var(--font-body);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 2px;
    line-height: 1.2;
    margin-bottom: 15px;
    text-transform: uppercase;
  }

  .nptc-banner .badge {
    display: block;
    margin: 55px auto 0;
    max-width: 250px;
  }

  .nptc-banner figure {
    margin: 50px auto 0;
    max-width: 600px;
    position: relative;
  }

  .nptc-banner figure :global(img) {
    display: block;
    height: auto;
    width: 100%;
  }

  .nptc-banner figcaption {
    background: rgba(255, 255, 255, 0.8);
    bottom: 20px;
    color: #1a1a1a;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1.6px;
    line-height: 1.2;
    padding: 10px 30px 10px 35px;
    position: absolute;
    right: 0;
    text-align: right;
    text-transform: uppercase;
  }

  @media (min-width: 1024px) {
    .nptc-banner article {
      flex: 0 0 auto;
      padding: 190px 20px 290px 130px;
      text-align: left;
    }

    .nptc-banner article::before {
      display: block;
    }

    .nptc-banner .badge.mobile-only {
      display: none;
    }

    .nptc-banner h1 {
      font-size: 74px;
    }

    .nptc-banner h1 small {
      font-size: 21px;
      letter-spacing: 2.1px;
    }

    .nptc-banner figure {
      flex: 0 1 756px;
      margin: 20px 0 0 auto;
      max-width: none;
      min-width: 0;
    }

    .nptc-banner figcaption {
      bottom: auto;
      padding: 15px 50px 10px 60px;
      top: 69%;
    }
  }
</style>
