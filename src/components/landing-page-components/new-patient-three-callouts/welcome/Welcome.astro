---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";

interface Paragraph {
  emphasis: string;
  body: string;
}

const {
  heading = "",
  paragraphs = [] as Paragraph[],
  accentColor = "",
  headingColor = "",
  backgroundColor = "base",
  class: className,
  ...rest
} = Astro.props;

const inlineStyle = [
  accentColor ? `--nptc-accent-color: ${accentColor}` : "",
  headingColor ? `--nptc-heading-color: ${headingColor}` : "",
]
  .filter(Boolean)
  .join("; ");

const htmlAttributes = Object.fromEntries(
  Object.entries(rest).filter(([key]) => key !== "_component")
);
---

<CustomSection
  class:list={["nptc-welcome", className]}
  paddingVertical="4xl"
  paddingHorizontal="md"
  colorScheme="default"
  backgroundColor={backgroundColor}
  style={inlineStyle || undefined}
  {...htmlAttributes}
>
  <div class="inner">
    {heading && <Heading text={heading} level="h2" alignX="center" data-prop="heading" />}
    {
      paragraphs.map((p: Paragraph) => (
        <p>
          {p.emphasis && <strong>{p.emphasis}</strong>}
          {p.emphasis && " "}
          <Fragment set:html={p.body} />
        </p>
      ))
    }
  </div>
</CustomSection>

<style>
  .nptc-welcome .inner {
    margin: 0 auto;
    max-width: 1090px;
    text-align: center;
  }

  .nptc-welcome p {
    font-family: var(--font-body);
    font-size: 21px;
    line-height: 1.8;
    margin: 0.75rem auto;
  }

  .nptc-welcome .inner :global(.heading) {
    color: var(--nptc-heading-color, var(--color-brand));
    font-family: var(--font-headings);
    font-size: 56px;
    font-weight: 500;
    line-height: 1.1;
    margin: 0 auto 30px;
  }

  @media (min-width: 1024px) {
    .nptc-welcome p {
      font-size: 22px;
      line-height: 1.65;
    }

    .nptc-welcome .inner :global(.heading) {
      font-size: 70px;
    }
  }

  /* Emphasized phrase at the start of each paragraph */
  .nptc-welcome p strong {
    color: var(--nptc-accent-color, var(--color-brand));
    font-weight: 500;
  }
</style>
